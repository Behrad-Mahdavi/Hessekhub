{
  "name": "hessekhub-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" && stylelint \"packages/**/*.css\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @hessekhub/database db:generate",
    "db:push": "pnpm --filter @hessekhub/database db:push",
    "db:seed": "pnpm --filter @hessekhub/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
