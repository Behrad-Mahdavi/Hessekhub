NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database & Cache
DATABASE_URL="postgresql://hessekhub:hessekhub_dev_pass@localhost:5432/hessekhub_core?schema=public"
REDIS_URL="redis://localhost:6379"

# S3 / MinIO Media & Encrypted Health Photos (K-03)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ir-mashhad-1"
S3_ACCESS_KEY="hessekhub_minio"
S3_SECRET_KEY="hessekhub_minio_secret"
S3_PUBLIC_BUCKET="hessekhub-media"
S3_PRIVATE_HEALTH_BUCKET="hessekhub-health-encrypted"
HEALTH_PHOTO_ENCRYPTION_KEY="change-this-to-32-byte-hex-key-in-prod"

# Auth & Internal ISR Revalidation
JWT_SECRET="change-this-super-secret-jwt-key"
OTP_TTL_SECONDS=120
REVALIDATE_WEBHOOK_SECRET="change-this-revalidate-secret-token"

# Iranian Payment Gateways & SMS (Abstraction Layer)
DEFAULT_PAYMENT_GATEWAY="ZARINPAL"
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX=true

SMS_PROVIDER="KAVENEGAR"
KAVENEGAR_API_KEY="your-kavenegar-api-key"
KAVENEGAR_OTP_TEMPLATE="hessekhub-otp"

